    <string name="settings_lock_needs_secure">Set up a device screen lock first.</string>
    <string name="settings_lock_scope">This lock protects the ClonApps screen only. Cloned apps can still be opened from the launcher.</string>
    <string name="settings_pause_note">Pause applies to the whole work profile, not per app. Android only lets the default launcher or system apps do this directly. If refused, use the \"Work apps\" toggle in Quick Settings or the launcher.</string>
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_body">ClonApps works without servers, without a ClonApps account and without telemetry. Configuration stays local and is excluded from backup. ClonApps does not collect credentials or cloned app content.</string>
    <string name="settings_profile">Work profile</string>
    <string name="settings_profile_lock_note">To protect every app in the work profile, set a separate work profile lock. Android enforces it.</string>
    <string name="settings_show_system">Show system apps by default</string>
    <string name="settings_theme">Theme</string>
    <string name="settings_wipe_note">Removes the entire ClonApps work profile with every clone in it. Other profiles are not touched.</string>
